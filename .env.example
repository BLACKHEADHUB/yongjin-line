# 이 파일을 복사해서 .env.local을 만들고 값을 채우세요. .env.local은 절대 커밋하지 않습니다.

# MongoDB Atlas 연결 문자열 (Atlas > Connect > Drivers 에서 복사)
MONGODB_URI=
# 사용할 데이터베이스 이름 (비워 두면 yongjin_line)
MONGODB_DB=

# /admin 로그인 비밀번호 (길고 추측하기 어렵게)
ADMIN_PASSWORD=
# 관리자 로그인 쿠키를 서명하는 비밀 값 (긴 무작위 문자열, 예: openssl rand -base64 32)
SESSION_SECRET=
